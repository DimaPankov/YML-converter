<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            version="1.1.0.0"
            targetNamespace="http://market.zakupki.mos.ru/spIntegration/Yml/1.0"
            xmlns="http://market.zakupki.mos.ru/spIntegration/Yml/1.0"
            xmlns:c="http://market.zakupki.mos.ru/spIntegration/Yml/1.0/common"
            elementFormDefault="qualified">
  <xsd:import namespace="http://market.zakupki.mos.ru/spIntegration/Yml/1.0/common"
              schemaLocation="schema.common.xsd"/>

  <xsd:element name="yml_catalog">
    <xsd:annotation>
      <xsd:documentation>Пакет импорта оферт в формате yml.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="shop">
          <xsd:annotation>
            <xsd:documentation>
              Данные для импорта.
            </xsd:documentation>
          </xsd:annotation>
          <xsd:complexType>
            <xsd:all>
              <xsd:element name="name" type="xsd:anyType" minOccurs="0"/>
              <xsd:element name="company" type="xsd:anyType" minOccurs="0"/>
              <xsd:element name="url" type="xsd:anyType" minOccurs="0"/>
              <xsd:element name="phone" type="xsd:anyType" minOccurs="0"/>
              <xsd:element name="platform" type="xsd:anyType" minOccurs="0"/>
              <xsd:element name="version" type="xsd:anyType" minOccurs="0"/>
              <xsd:element name="agency" type="xsd:anyType" minOccurs="0"/>
              <xsd:element name="email" type="xsd:anyType" minOccurs="0"/>
              <xsd:element name="store" type="xsd:anyType" minOccurs="0"/>
              <xsd:element name="pickup" type="xsd:anyType" minOccurs="0"/>
              <xsd:element name="delivery" type="xsd:anyType" minOccurs="0"/>
              <xsd:element name="deliveryIncluded" type="xsd:anyType" minOccurs="0"/>
              <xsd:element name="local_delivery_cost" type="xsd:anyType" minOccurs="0"/>
              <xsd:element name="adult" type="xsd:anyType" minOccurs="0"/>
              <xsd:element name="cpa" type="xsd:anyType" minOccurs="0"/>
              <xsd:element name="fee" type="xsd:anyType" minOccurs="0"/>
              <xsd:element name="currencies">
                <xsd:annotation>
                  <xsd:documentation>
                    Справочник используемых валют.
                  </xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="currency" minOccurs="1" type="currencyType"
                                 maxOccurs="unbounded"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:all>
          </xsd:complexType>
        </xsd:element>
        <xsd:element name="categories">
          <xsd:annotation>
            <xsd:documentation>
              Справочник категорий представленной продукции.
            </xsd:documentation>
          </xsd:annotation>
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="category" minOccurs="1" type="categoryType"
                           maxOccurs="unbounded"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element name="delivery-options" type="deliveryOptionsType" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Опции доставки</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="offers" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Коллекция оферт для импорта.</xsd:documentation>
          </xsd:annotation>
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="offer" minOccurs="0" type="offerType"
                           maxOccurs="unbounded">
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
          <xsd:element name="variantOfferGroups" minOccurs="0">
              <xsd:annotation>
                  <xsd:documentation>Коллекция вариативных оферт для импорта.</xsd:documentation>
              </xsd:annotation>
              <xsd:complexType>
                  <xsd:sequence>
                      <xsd:element name="variantOfferGroup" minOccurs="0" type="variantGroupOfferType" maxOccurs="unbounded" />
                  </xsd:sequence>
              </xsd:complexType>
          </xsd:element>
      </xsd:sequence>
      <xsd:attribute name="date" type="xsd:string"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:complexType name="currencyType">
    <xsd:attribute name="id" use="required">
      <xsd:simpleType>
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value="RUR"/>
          <xsd:enumeration value="RUB"/>
          <xsd:enumeration value="USD"/>
          <xsd:enumeration value="BYR"/>
          <xsd:enumeration value="BYN"/>
          <xsd:enumeration value="KZT"/>
          <xsd:enumeration value="EUR"/>
          <xsd:enumeration value="UAH"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:attribute>
    <xsd:attribute default="1" name="rate" type="xsd:string"/>
    <xsd:attribute default="0" name="plus" type="xsd:string"/>
  </xsd:complexType>
  <xsd:complexType name="categoryType">
    <xsd:simpleContent>
      <xsd:extension base="xsd:string">
        <xsd:attribute name="id" type="xsd:string" use="required"/>
        <xsd:attribute name="parentId" type="xsd:string"/>
        <xsd:attribute name="tid" type="xsd:string"/>
        <xsd:attribute name="yid" type="xsd:string"/>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>

  <xsd:complexType name="validationResultPacket">
    <xsd:annotation>
      <xsd:documentation>Пакет данных валидации</xsd:documentation>
    </xsd:annotation>
    <xsd:all>
      <xsd:element name="violations" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Нарушения правил</xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="violation" minOccurs="0"
                         type="validationViolationType" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="isValid" type="xsd:boolean" minOccurs="1">
        <xsd:annotation>
          <xsd:documentation>Признак успешного прохождения правил</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:all>
  </xsd:complexType>
  <xsd:complexType name="validationViolationType">
    <xsd:annotation>
      <xsd:documentation>Нарушение валидационного правила</xsd:documentation>
    </xsd:annotation>
    <xsd:all>
      <xsd:element name="relatedTo">
        <xsd:annotation>
          <xsd:documentation>Относится к</xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
          <xsd:attribute name="id" type="xsd:int"/>
          <xsd:attribute name="code" type="xsd:string"/>
          <xsd:attribute name="name" type="xsd:string"/>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="violations" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Вложенные нарушения</xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="violation" minOccurs="0"
                         type="validationViolationType" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:all>
    <xsd:attribute name="field" type="xsd:string"/>
    <xsd:attribute name="message" type="xsd:string"/>
    <xsd:attribute name="class">
      <xsd:simpleType>
        <xsd:restriction base="validationViolationClass"/>
      </xsd:simpleType>
    </xsd:attribute>
  </xsd:complexType>
  <xsd:simpleType name="validationViolationClass">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="parse"/>
      <xsd:enumeration value="business"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:complexType name="offerType">
    <xsd:annotation>
      <xsd:documentation>Данные для импорта оферты</xsd:documentation>
    </xsd:annotation>
    <xsd:choice minOccurs="0" maxOccurs="unbounded">
      <!--Yml elements-->
      <xsd:element name="url" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="buyurl" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="oldprice" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="wprice" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="xCategory" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="market_category" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="store" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="pickup" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="delivery" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="deliveryIncluded" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="local_delivery_cost" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="orderingTime" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="typePrefix" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="provider" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="tarifplan" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="author" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="publisher" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="series" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="year" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="ISBN" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="volume" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="part" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="language" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="binding" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="page_extent" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="table_of_contents" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="performed_by" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="performance_type" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="storage" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="format" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="recording_length" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="artist" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="title" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="media" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="starring" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="director" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="originalName" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="country" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="worldRegion" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="days" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="dataTour" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="hotel_stars" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="room" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="meal" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="included" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="transport" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="price_min" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="price_max" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="options" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="place" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="hall" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="hall_part" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="date" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="is_premiere" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="is_kids" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="aliases" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="additional" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="promo" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="manufacturer_warranty" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="seller_warranty" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="country_of_origin" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="downloadable" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="adult" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="age" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="cpa" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="fee" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="rec" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="expiry" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="related_offer" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="pricelabs_param" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="purchase_price" type="xsd:anyType" minOccurs="0"/>
      <xsd:element name="name" type="xsd:string" minOccurs="1">
        <xsd:annotation>
          <xsd:documentation>
            Наименование(ключ) оферты. При загрузке заменяется на системное наименование.
          </xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:choice minOccurs="1" maxOccurs="1">
        <xsd:element name="categoryId">
          <xsd:annotation>
            <xsd:documentation>
              Идентификатор категории в иерархии поставщика.
            </xsd:documentation>
          </xsd:annotation>
          <xsd:complexType>
            <xsd:simpleContent>
              <xsd:extension base="xsd:string">
                <xsd:attribute default="Own" name="type">
                  <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                      <xsd:enumeration value="Yandex"/>
                      <xsd:enumeration value="Torg"/>
                      <xsd:enumeration value="Own"/>
                    </xsd:restriction>
                  </xsd:simpleType>
                </xsd:attribute>
              </xsd:extension>
            </xsd:simpleContent>
          </xsd:complexType>
        </xsd:element>
        <xsd:element name="ppCategory" type="xsd:int">
          <xsd:annotation>
            <xsd:documentation>Вид продукции</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
      </xsd:choice>
      <xsd:element name="currencyId" type="xsd:string">
        <xsd:annotation>
          <xsd:documentation>Валюта единицы продукции</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="price">
        <xsd:annotation>
          <xsd:documentation>Цена за единицу продукции</xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
          <xsd:simpleContent>
            <xsd:extension base="xsd:string">
              <xsd:attribute name="from" type="xsd:string"/>
            </xsd:extension>
          </xsd:simpleContent>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="vat" type="ndsType"/>
      <xsd:element name="min-quantity" type="xsd:decimal">
        <xsd:annotation>
          <xsd:documentation>Минимальное кол-во</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="delivery-options" type="deliveryOptionsType">
        <xsd:annotation>
          <xsd:documentation>Опции доставки</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="picture" type="xsd:string" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation>Изображение</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="description" type="xsd:string">
        <xsd:annotation>
          <xsd:documentation>Дополнительные характеристики</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="sales_notes" type="xsd:string">
        <xsd:annotation>
          <xsd:documentation>Дополнительные сведения</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="model" type="xsd:string">
        <xsd:annotation>
          <xsd:documentation>Наименование модели</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="dimensions" type="xsd:string" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Габаритные размеры товара с упаковкой</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="weight" type="xsd:string" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Вес товара с упаковкой</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="barcode" type="xsd:string" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Баркод</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="vendor" type="xsd:string" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Производитель</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="vendorCode" type="xsd:string" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Каталожный номер</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="param" minOccurs="0" maxOccurs="unbounded">
        <xsd:complexType>
          <xsd:simpleContent>
            <xsd:extension base="xsd:string">
              <xsd:attribute name="name" type="xsd:string" use="required"/>
              <xsd:attribute name="unit" type="xsd:string"/>
            </xsd:extension>
          </xsd:simpleContent>
        </xsd:complexType>
      </xsd:element>
      <!--spIntegration elements-->
      <xsd:element name="isVisibleToStateCustomers" type="xsd:boolean" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>
            Показывать государственным заказчикам.
          </xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="isAvailableToIndividuals" type="xsd:boolean" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>
            Доступно для заказа физическими лицами
          </xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="okei" type="okeiType" minOccurs="1">
        <xsd:annotation>
          <xsd:documentation>Единица измерения</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="discounts" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Скидки за количество</xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="discount" minOccurs="0" maxOccurs="unbounded">
              <xsd:complexType>
                <xsd:sequence>
                  <xsd:element name="costPerUnit" type="c:money">
                    <xsd:annotation>
                      <xsd:documentation>
                        Цена за единицу
                        продукции
                      </xsd:documentation>
                    </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="costPerUnitWithoutNds" type="c:money"
                               minOccurs="0">
                    <xsd:annotation>
                      <xsd:documentation>
                        Цена за единицу
                        продукции без НДС
                      </xsd:documentation>
                    </xsd:annotation>
                  </xsd:element>
                  <xsd:element name="startValue" type="xsd:int"
                               minOccurs="0">
                    <xsd:annotation>
                      <xsd:documentation>
                        Кол-во
                      </xsd:documentation>
                    </xsd:annotation>
                  </xsd:element>
                </xsd:sequence>
              </xsd:complexType>
            </xsd:element>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="max-quantity" type="xsd:decimal" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Максимальное кол-во</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="beginDate" type="xsd:dateTime">
        <xsd:annotation>
          <xsd:documentation>Дата начала действия</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="endDate" type="xsd:dateTime">
        <xsd:annotation>
          <xsd:documentation>Дата окончания действия</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="package" type="packageType" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Тип упаковки</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="packageComment" type="xsd:string" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>
            Единица упаковки (иная) (тип упаковки не
            представленный в справочнике)
          </xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="perPackage" type="c:fixed" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>
            Количество единиц в упаковке
          </xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="regions" minOccurs="1">
        <xsd:annotation>
          <xsd:documentation>Регионы поставки</xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
          <xsd:choice>
            <xsd:element name="region" minOccurs="1" maxOccurs="unbounded" type="regionType"/>
          </xsd:choice>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="oksm" type="oksmType" minOccurs="1">
        <xsd:annotation>
          <xsd:documentation>Оксм код (страна происхождения)</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="contractProject" type="c:url" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Проект контракта</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="tags" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Теги</xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="tag" minOccurs="0" type="tagType" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="ste" type="xsd:int" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Код СТЕ</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:choice>
    <xsd:attribute name="id" type="xsd:string" use="required"/>
    <xsd:attribute name="group_id" type="xsd:string" use="optional"/>
    <xsd:attribute name="type" use="optional">
      <xsd:simpleType>
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value="vendor.model"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:attribute>
    <xsd:attribute name="available" use="optional">
      <xsd:simpleType>
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value="true"/>
          <xsd:enumeration value="false"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:attribute>
    <xsd:attribute name="bid" type="xsd:string" use="optional"/>
    <xsd:attribute name="cbid" type="xsd:string" use="optional"/>
    <xsd:attribute name="sbid" type="xsd:string" use="optional"/>
    <xsd:attribute name="fee" type="xsd:string" use="optional"/>
  </xsd:complexType>
    <xsd:complexType name="variantOfferType">
        <xsd:annotation>
            <xsd:documentation>Данные для импорта вариативной оферты</xsd:documentation>
        </xsd:annotation>
        <xsd:complexContent>
            <xsd:extension base="offerType" />
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:complexType name="variantGroupOfferType">
        <xsd:annotation>
            <xsd:documentation>Данные для группы вариативных оферт</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="vendor" type="xsd:string" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>Производитель</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="ppCategory" type="xsd:int">
                <xsd:annotation>
                    <xsd:documentation>Вид продукции</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="categoryId" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>Идентификатор категории в иерархии поставщика.</xsd:documentation>
                </xsd:annotation>
                <xsd:complexType>
                    <xsd:simpleContent>
                        <xsd:extension base="xsd:string">
                            <xsd:attribute default="Own" name="type">
                                <xsd:simpleType>
                                    <xsd:restriction base="xsd:string">
                                        <xsd:enumeration value="Yandex"/>
                                        <xsd:enumeration value="Torg"/>
                                        <xsd:enumeration value="Own"/>
                                    </xsd:restriction>
                                </xsd:simpleType>
                            </xsd:attribute>
                        </xsd:extension>
                    </xsd:simpleContent>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="model" type="xsd:string" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>Наименование модели</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="param" minOccurs="0" maxOccurs="unbounded">
                <xsd:complexType>
                    <xsd:simpleContent>
                        <xsd:extension base="xsd:string">
                            <xsd:attribute name="name" type="xsd:string" use="required"/>
                            <xsd:attribute name="unit" type="xsd:string"/>
                        </xsd:extension>
                    </xsd:simpleContent>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="variantOffer" type="variantOfferType" minOccurs="1" maxOccurs="unbounded"/>
        </xsd:sequence>
        <xsd:attribute name="id" type="xsd:string" use="required"/>
    </xsd:complexType>
    <xsd:complexType name="deliveryOptionsType">
    <xsd:sequence>
      <xsd:element name="option" minOccurs="0" maxOccurs="unbounded">
        <xsd:complexType>
          <xsd:attribute name="cost" type="xsd:string" use="required"/>
          <xsd:attribute name="days" type="xsd:string" use="required"/>
          <xsd:attribute name="order-before" type="xsd:string"/>
        </xsd:complexType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="okeiType">
    <xsd:annotation>
      <xsd:documentation>Единица измерения</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="c:vocabularyType"/>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="unitType">
    <xsd:annotation>
      <xsd:documentation>Единица измерения характеристики</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="c:vocabularyType"/>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:simpleType name="ndsType" final="restriction">
    <xsd:annotation>
      <xsd:documentation>Ставка НДС</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="NO_VAT"/>
      <xsd:enumeration value="Без НДС"/>
      <xsd:enumeration value="0"/>
      <xsd:enumeration value="VAT_0"/>
	  <xsd:enumeration value="5"/>
      <xsd:enumeration value="VAT_5"/>
	  <xsd:enumeration value="7"/>
      <xsd:enumeration value="VAT_7"/>
      <xsd:enumeration value="10"/>
      <xsd:enumeration value="VAT_10"/>
      <xsd:enumeration value="18"/>
      <xsd:enumeration value="VAT_18"/>
      <xsd:enumeration value="20"/>
      <xsd:enumeration value="VAT_20"/>
      <xsd:enumeration value="22"/>
      <xsd:enumeration value="VAT_22"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:complexType name="packageType">
    <xsd:annotation>
      <xsd:documentation>Тип упаковки</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="c:vocabularyType"/>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="regionType">
    <xsd:annotation>
      <xsd:documentation>Регион</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="c:vocabularyType"/>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="oksmType">
    <xsd:annotation>
      <xsd:documentation>Оксм</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="c:vocabularyType"/>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="tagType">
    <xsd:annotation>
      <xsd:documentation>Тег</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="c:vocabularyType"/>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:element name="offerPriceUpdatePacket">
    <xsd:annotation>
      <xsd:documentation>Пакет обновления прайс-листа</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="offerPrices">
          <xsd:annotation>
            <xsd:documentation>Коллекия цен оферт для импорта.</xsd:documentation>
          </xsd:annotation>
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="offerPrice" minOccurs="1" type="offerPriceUpdateType" maxOccurs="unbounded"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="offerPrice" type="offerPriceUpdateType">
  </xsd:element>
  <xsd:complexType name="offerPriceUpdateType">
    <xsd:annotation>
      <xsd:documentation>Данные для обновление стоимости в оферте</xsd:documentation>
    </xsd:annotation>
    <xsd:all>
      <xsd:element name="code" minOccurs="1">
        <xsd:annotation>
          <xsd:documentation>Артикул</xsd:documentation>
        </xsd:annotation>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:maxLength value="50"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element name="costPerUnit" type="c:money" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Цена за единицу продукции</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="minValue" type="xsd:decimal"
                   minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Минимальное кол-во</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="maxValue" type="xsd:decimal"
                   minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Максимальное кол-во</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="maxValueUnbounded" type="xsd:boolean"
                   minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Максимальное кол-во неограничено</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="endDate" type="xsd:dateTime">
        <xsd:annotation>
          <xsd:documentation>Дата окончания действия</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="ste" type="xsd:int">
        <xsd:annotation>
          <xsd:documentation>Код СТЕ</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:all>
  </xsd:complexType>
</xsd:schema>
